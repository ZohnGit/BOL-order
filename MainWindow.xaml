<Window x:Class="BolOrderExporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOL 订单导出工具" Height="720" Width="980"
        MinHeight="620" MinWidth="820" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="BOL 订单导出工具" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="HeaderSubtitle" Text="登录店铺 API 后开始处理订单" Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <!-- Stage 1: credentials and real API login -->
        <Border x:Name="LoginPanel" Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="34" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="登录" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="请选择已保存的账号，或输入新的 API 账号。" Margin="0,7,0,24" Foreground="{StaticResource MutedBrush}" />

                <TextBlock Text="User" Margin="0,0,0,6" FontWeight="SemiBold" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="UserComboBox" IsEditable="True" FontSize="14" Padding="10,8"
                              DisplayMemberPath="User" SelectionChanged="UserComboBox_SelectionChanged" />
                    <Button x:Name="DeleteCredentialButton" Grid.Column="1" Content="删除这对账号" Margin="10,0,0,0"
                            Background="#E2E8F0" Foreground="#334155" Click="DeleteCredentialButton_Click" />
                </Grid>

                <TextBlock Text="Password（按要求明文显示）" Margin="0,18,0,6" FontWeight="SemiBold" />
                <TextBox x:Name="PasswordTextBox" />

                <TextBlock x:Name="LoginMessage" Margin="0,14,0,0" Foreground="#DC2626" TextWrapping="Wrap" />
                <Button x:Name="LoginButton" Content="登录" Height="46" Margin="0,22,0,0" Click="LoginButton_Click" />
            </StackPanel>
        </Border>

        <!-- Stage 2: date selection -->
        <Border x:Name="DatePanel" Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="34" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="登录成功" FontSize="16" Foreground="#15803D" FontWeight="SemiBold" />
                <TextBlock Text="选择日期" FontSize="24" FontWeight="Bold" Margin="0,12,0,6" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="请选择要处理的订单日期。" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,22" />
                <DatePicker x:Name="TargetDatePicker" SelectedDateFormat="Long" FontSize="16" Padding="8" />
                <TextBlock x:Name="DateMessage" Margin="0,12,0,0" Foreground="#DC2626" />
                <Button x:Name="StartButton" Content="开始运行" Height="46" Margin="0,22,0,0" Click="StartButton_Click" />
                <Button Content="返回登录" Margin="0,10,0,0" Background="#E2E8F0" Foreground="#334155" Click="BackToLoginButton_Click" />
            </StackPanel>
        </Border>

        <!-- Stage 3: progress and output -->
        <Grid x:Name="RunPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="24">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="运行进度" FontWeight="SemiBold" FontSize="17" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="ProgressPercentText" Text="0%" HorizontalAlignment="Right" FontWeight="Bold" FontSize="17" Foreground="{StaticResource PrimaryBrush}" />
                    </Grid>
                    <ProgressBar x:Name="RunProgressBar" Minimum="0" Maximum="100" Value="0" Height="16" Margin="0,13,0,10" />
                    <TextBlock x:Name="ProgressStatusText" Text="等待开始…" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="RunErrorText" Margin="0,10,0,0" Foreground="#DC2626" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20" Margin="0,18,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="取消单" FontWeight="SemiBold" FontSize="17" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="CancelledCountText" Text="（0）" Margin="6,1,0,0" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <Button x:Name="CopyCancelledButton" Content="复制取消单" HorizontalAlignment="Right" Padding="14,7"
                                Background="#E2E8F0" Foreground="#334155" IsEnabled="False" Click="CopyCancelledButton_Click" />
                    </Grid>
                    <DataGrid x:Name="CancelledDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="取消单订单号" Binding="{Binding OrderId}" Width="*" />
                            <DataGridTextColumn Header="取消单下单时间" Binding="{Binding OrderPlacedDateTime}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Button Content="重新选择日期" HorizontalAlignment="Left" Background="#E2E8F0" Foreground="#334155" Click="ChooseAnotherDateButton_Click" />
                <Button x:Name="SaveXlsxButton" Content="获取 XLSX 文件" HorizontalAlignment="Right" IsEnabled="False" Click="SaveXlsxButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
